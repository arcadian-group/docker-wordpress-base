server {
	listen 80 default_server;
	listen [::]:80 default_server ipv6only=on;

	root /var/www/html;
	index index.php index.html index.htm;

	set $skip_cache 0;

	# POST requests and urls with a query string should always go to PHP
	if ($request_method = POST) {
		set $skip_cache 1;
	}
	if ($query_string != "") {
		set $skip_cache 1;
	}

	# Don't cache uris containing the following segments
	if ($request_uri ~* "(/wp-admin/|/xmlrpc.php|/wp-.*.php|/feed/|index.php|sitemap(_index)?.xml|[a-z0-9_-]+-sitemap([0-9]+)?.xml)") {
		set $skip_cache 1;
	}

	# Don't use the cache for logged in users or recent commenters
	if ($http_cookie ~* "(comment_author|wordpress_[a-f0-9]+|wp\-postpass|wordpress_no_cache|wordpress_logged_in|wptouch_switch_toggle)") {
		set $skip_cache 1;
	}

	location / {
		try_files $uri $uri/ /index.php$is_args$args;
		fastcgi_buffers 16 16k;
		fastcgi_buffer_size 32k;

        proxy_buffer_size          128k;
        proxy_buffers              4 256k;
        proxy_busy_buffers_size    256k;
	}

	location ~ \.php$ {
		try_files $uri /index.php =404;
		fastcgi_buffers 16 16k;
		fastcgi_buffer_size 32k;

        proxy_buffer_size          128k;
        proxy_buffers              4 256k;
        proxy_busy_buffers_size    256k;
		fastcgi_pass unix:/run/php/php8.0-fpm.sock;
		fastcgi_index index.php;
		fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
		fastcgi_read_timeout 300;
		include fastcgi_params;

		fastcgi_cache_bypass $skip_cache;
		fastcgi_no_cache $skip_cache;

		fastcgi_cache WORDPRESS;
		fastcgi_cache_valid  60m;
	}

	location ~ /purge(/.*) {
		fastcgi_cache_purge WORDPRESS "$scheme$request_method$host$1";
	}

	location ~ /\.ht {
		deny all;
	}

	location ~ .*\.(env)$ {
		deny all;
	}

	location ~ /\. {
		deny all;
	}

	location /taskdef-production.json {
		deny all;
	}

    location /Dockerfile {
		deny all;
	}

    location /README.md {
		deny all;
	}

    location /docker-compose.yml {
		deny all;
	}

	location /taskdef-staging.json {
		deny all;
	}

	location ~\.(yaml|yml)$ {
		deny all;
	}

	location ~*  \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|otf)$ {
	   expires 365d;
       add_header Pragma public;
       add_header Cache-Control "public";
	}

	access_log /dev/stdout;
	error_log /dev/stderr;
	client_max_body_size 20m;

	gzip on;
	gzip_disable "msie6";

	gzip_vary on;
	gzip_proxied any;
	gzip_comp_level 6;
	gzip_buffers 16 8k;
	gzip_http_version 1.1;
	gzip_types text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
}
